# Radicale config for tests/pim_radicale.rs (LOCAL test server only, plain-text htpasswd on purpose).
# Source: Radicale documentation "Configuration" — [server] hosts, [auth] type/htpasswd_filename/htpasswd_encryption,
# [storage] filesystem_folder.
[server]
hosts = 0.0.0.0:5232

[auth]
type = htpasswd
htpasswd_filename = /config/users
htpasswd_encryption = plain

[storage]
filesystem_folder = /data/collections
