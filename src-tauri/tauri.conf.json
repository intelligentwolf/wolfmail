{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WolfMail",
  "version": "0.1.0",
  "identifier": "uk.co.intelligentwolf.wolfmail",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WolfMail",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'self' blob: data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'self' blob: data:; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; script-src 'self' 'unsafe-inline' http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Email that works \u2014 and knows your customers.",
    "copyright": "\u00a9 2026 IntelligentWolf Ltd",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAzNjdGRjY4QjE2NTZFRkIKUldUN2JtV3hhUDluQXowUXdPRzRWVmRmRVpOaHowOVF1VTFnT2VpR3NwWE5KZFN5QlVjbDVxVzUK",
      "endpoints": [
        "https://github.com/IntelligentWolf-Ltd/wolfmail-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
